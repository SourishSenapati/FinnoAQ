{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MotorLoadMasterSchema",
  "type": "object",
  "required": [
    "metadata",
    "motors"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "document_id",
        "revision",
        "total_motor_count",
        "total_connected_kw",
        "total_operating_kw"
      ],
      "properties": {
        "document_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "total_motor_count": {
          "type": "integer"
        },
        "total_connected_kw": {
          "type": "number"
        },
        "total_operating_kw": {
          "type": "number"
        }
      }
    },
    "motors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "equipment_tag",
          "motor_description",
          "area_zone",
          "rated_kw",
          "voltage",
          "starter_type",
          "vfd_required",
          "operating_kw_base"
        ],
        "properties": {
          "equipment_tag": {
            "type": "string"
          },
          "motor_description": {
            "type": "string"
          },
          "area_zone": {
            "type": "string"
          },
          "rated_kw": {
            "type": "number"
          },
          "voltage": {
            "type": "string"
          },
          "starter_type": {
            "type": "string"
          },
          "vfd_required": {
            "type": "boolean"
          },
          "operating_kw_base": {
            "type": "number"
          }
        }
      }
    }
  }
}